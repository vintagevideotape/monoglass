{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monoglass",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  // Один воркер отдаёт и приложение, и API: один адрес, один вход.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // База в аккаунте владельца (создана 11.11.2026, регион — Восточная Европа).
  "d1_databases": [{ "binding": "DB", "database_name": "monoglass", "database_id": "5968375e-1481-4853-9a81-606982871fe9", "migrations_dir": "migrations" }],
  // Раз в две минуты — один запрос к Monobank (лимит банка: один запрос в минуту).
  "triggers": { "crons": ["*/2 * * * *"] },
  "preview_urls": false,
  "vars": { "BACKFILL_DAYS": "400" }
  // Секреты задаются командой `wrangler secret put`, в репозиторий не попадают:
  // TOKEN_KEY (ключ шифрования токенов Monobank), TEAM_DOMAIN, POLICY_AUD.
  // Сам токен Monobank вводится в приложении и хранится в базе зашифрованным.
}
