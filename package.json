{
  "name": "monoglass-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "dev:api": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply monoglass --remote",
    "db:migrate:local": "wrangler d1 migrations apply monoglass --local",
    "e2e": "esbuild scripts/e2e.ts --bundle --platform=node --format=esm --log-level=warning | node --input-type=module",
    "setup:key": "node -e \"process.stdout.write(require('crypto').randomBytes(32).toString('base64'))\" | wrangler secret put TOKEN_KEY"
  },
  "dependencies": {
    "jose": "^6.2.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.1"
  }
}
